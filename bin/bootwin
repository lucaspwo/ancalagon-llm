#!/bin/bash
# bootwin — set UEFI BootNext to Windows and reboot.
# One-shot: firmware clears BootNext after consuming it, so the boot AFTER
# Windows returns to BootOrder default (Ubuntu). Return path is RealVNC into
# Windows, then `shutdown /r /t 0` from Windows to come back.
set -euo pipefail

DRY_RUN=0
if [ "${1:-}" = "--dry-run" ] || [ "${1:-}" = "-n" ]; then
  DRY_RUN=1
fi

WIN_LINE=$(sudo -n efibootmgr | grep -i 'Windows Boot Manager' | head -1 || true)
if [ -z "$WIN_LINE" ]; then
  echo "ERROR: no 'Windows Boot Manager' entry in efibootmgr" >&2
  echo "Available entries:" >&2
  sudo -n efibootmgr | grep -E '^Boot[0-9]' >&2 || true
  exit 1
fi

WIN_ID=$(echo "$WIN_LINE" | awk '{sub(/^Boot/,"",$1); sub(/\*/,"",$1); print $1}')
if ! [[ "$WIN_ID" =~ ^[0-9A-Fa-f]{4}$ ]]; then
  echo "ERROR: could not parse BootNum from: $WIN_LINE" >&2
  exit 1
fi

echo "Found Windows entry: Boot$WIN_ID"
echo "  $WIN_LINE"

if [ "$DRY_RUN" = 1 ]; then
  echo
  echo "[dry-run] Would execute:"
  echo "  sudo efibootmgr -n $WIN_ID"
  echo "  sudo systemctl reboot"
  exit 0
fi

echo
echo "Setting BootNext=$WIN_ID and rebooting in 5s. Ctrl+C to cancel."
sleep 5

sudo -n efibootmgr -n "$WIN_ID" >/dev/null
echo "BootNext set. Rebooting..."
# Detach so the SSH session doesn't block the reboot.
nohup sudo -n systemctl reboot >/dev/null 2>&1 &
disown
sleep 1
