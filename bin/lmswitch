#!/bin/bash
# lmswitch — switch between llama.cpp/colibri server presets on Ancalagon-Ubuntu.
# All six services bind :1234 and are mutually exclusive (single 16GB GPU).
set -euo pipefail

PORT=1234
COMMAND="${1:-status}"

usage() {
  cat <<EOF
Usage: lmswitch {coder|qwen36|qwen38|gemma4|flint|colibri|off|sleep|status|logs}

  coder    — start upstream llama.cpp with Qwen3-Coder-30B-A3B (MoE, ncmoe=16)
  qwen36   — start TQ3 fork with Qwen3.6-27B-TQ3_4S (100% GPU)
  qwen38   — start TQ3 fork with Qwen3.8-27B-IQ3_M (100% GPU)
  gemma4   — start upstream llama.cpp with Gemma 4 26B-A4B-it (MoE, ncmoe=8)
  flint    — start upstream llama.cpp with Recursive Flint 40B-A2.5B (MoE, ncmoe=24, ctx 128K)
  colibri  — start Colibri engine with Qwen3.6-35B-A3B (CUDA VRAM tier, ~70% experts resident)
  off      — stop any active llama/colibri server
  sleep    — stop services and suspend the system (wake via WoL)
  status   — show service states + health probe on :$PORT
  logs     — tail journal of the currently active server
EOF
  exit 1
}

wait_ready() {
  local svc="$1"
  local label="$2"
  local timeout="${3:-90}"
  printf 'Starting %s ' "$label" >&2
  for _ in $(seq 1 "$timeout"); do
    if ! systemctl --user is-active --quiet "$svc"; then
      printf '\nService %s is not active; aborting wait.\n' "$svc" >&2
      systemctl --user --no-pager status "$svc" | tail -15 >&2
      return 1
    fi
    if curl -fs -o /dev/null "http://localhost:$PORT/health" 2>/dev/null; then
      printf ' ready\n' >&2
      echo "http://localhost:$PORT (v1/chat/completions)"
      return 0
    fi
    printf '.' >&2
    sleep 1
  done
  printf '\nTimed out after %ss; check: journalctl --user -u %s -n 50\n' "$timeout" "$svc" >&2
  return 1
}

ALL_SERVICES=(llama-coder llama-qwen36 llama-qwen38 llama-gemma4 llama-flint colibri-qwen36)

stop_all() {
  for svc in "${ALL_SERVICES[@]}"; do
    systemctl --user stop "$svc.service" 2>/dev/null || true
  done
}

case "$COMMAND" in
  coder)
    stop_all
    systemctl --user start llama-coder.service
    wait_ready llama-coder.service "qwen3-coder (ncmoe=16)"
    ;;
  qwen36|qwen3.6|tq3)
    stop_all
    systemctl --user start llama-qwen36.service
    wait_ready llama-qwen36.service "qwen3.6-27b TQ3"
    ;;
  qwen38|qwen3.8)
    stop_all
    systemctl --user start llama-qwen38.service
    wait_ready llama-qwen38.service "qwen3.8-27b IQ3_M"
    ;;
  gemma4|gemma)
    stop_all
    systemctl --user start llama-gemma4.service
    wait_ready llama-gemma4.service "gemma-4-26b (ncmoe=8)"
    ;;
  flint)
    stop_all
    systemctl --user start llama-flint.service
    # 180s: o GGUF tem 25 GB; a carga a frio (fora do page cache) levou 75s em 2026-11-02.
    wait_ready llama-flint.service "flint-40b-a2.5b (ncmoe=24)" 180
    ;;
  colibri|colibri36)
    stop_all
    systemctl --user start colibri-qwen36.service
    wait_ready colibri-qwen36.service "qwen3.6-35b-a3b colibri (CUDA tier)"
    ;;
  off|stop)
    stop_all
    echo "All llama/colibri services stopped"
    ;;
  sleep|suspend)
    stop_all
    echo "Suspending system (wake with WoL)..."
    # Detach so the SSH connection doesn't block the suspend call.
    # sudo -n requires the NOPASSWD entry in /etc/sudoers.d/ for user lucas.
    nohup sudo -n systemctl suspend >/dev/null 2>&1 &
    disown
    sleep 1
    ;;
  status)
    for svc in "${ALL_SERVICES[@]}" lmstudio; do
      # is-active já imprime o estado no stdout e sai com código != 0 quando não está
      # ativo — um `|| echo inactive` aqui duplicaria a palavra na saída.
      state=$(systemctl --user is-active "$svc.service" 2>/dev/null || true)
      printf '%-20s %s\n' "${svc}.service:" "${state:-unknown}"
    done
    if curl -fs -o /dev/null "http://localhost:$PORT/health" 2>/dev/null; then
      echo ":$PORT healthy"
      # /v1/models expõe o caminho do GGUF em "model" (o campo "id" saiu do payload
      # em versões recentes do llama.cpp); não truncar antes do grep, o campo fica
      # além dos primeiros bytes conforme o modelo. O colibri usa "id" em vez de
      # "model" no payload, então o grep de "model" simplesmente não casa — sem
      # efeito colateral, só não imprime a linha "model:" nesse caso.
      meta=$(curl -fs "http://localhost:$PORT/v1/models" 2>/dev/null || true)
      model=$(printf '%s' "$meta" | grep -oE '"model":"[^"]+"' | head -1 | sed 's/^"model":"//; s/"$//')
      [ -n "$model" ] && echo "  model: $(basename "$model")"
    else
      echo ":$PORT not responding"
    fi
    ;;
  logs)
    for svc in "${ALL_SERVICES[@]}"; do
      if systemctl --user is-active --quiet "$svc.service"; then
        exec journalctl --user -u "$svc.service" -f -n 100
      fi
    done
    echo "No llama/colibri server currently active"
    exit 1
    ;;
  *) usage ;;
esac
