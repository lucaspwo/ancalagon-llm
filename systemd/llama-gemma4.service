[Unit]
Description=llama.cpp server - Gemma 4 26B-A4B-it (MoE, n-cpu-moe=8, ub 2048, t 6, KV q4_0)
Conflicts=llama-coder.service llama-qwen36.service llama-qwen38.service lmstudio.service colibri-qwen36.service llama-flint.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lucas/git/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
# -ub/-b 2048: turno de 14K tokens 2511 -> 4660 tok/s (6,0 s -> 3,2 s), +580 MiB de VRAM (ainda
# ~1,8 GB livres, ncmoe fica em 8). -t 6 (núcleos físicos) > -t 12. TUNING.md §19.
ExecStart=/home/lucas/git/llama.cpp/build/bin/llama-server -m /home/lucas/.lmstudio/models/lmstudio-community/gemma-4-26B-A4B-it-GGUF/gemma-4-26B-A4B-it-Q4_K_M.gguf --host 0.0.0.0 --port 1234 -c 98304 -ngl 99 -fa 1 -ctk q4_0 -ctv q4_0 -t 6 --n-cpu-moe 8 -ub 2048 -b 2048 --jinja
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
