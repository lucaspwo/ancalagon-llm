ExecStart=/home/lucas/git/llama.cpp-tq3/build/bin/llama-server -m /home/lucas/models/gguf/Qwen3.6-27B-TQ3_4S.gguf --host 0.0.0.0 --port 1234 -c 40960 -ngl 99 -fa 1 -ctk q8_0 -ctv q8_0 -t 12 --jinja
