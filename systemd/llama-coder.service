[Unit]
Description=llama.cpp server - Qwen3-Coder-30B (MoE, n-cpu-moe=17, ub 2048, t 6, 100%% attention on GPU)
Conflicts=llama-qwen36.service llama-gemma4.service llama-qwen38.service lmstudio.service colibri-qwen36.service llama-flint.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lucas/git/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
# -ub/-b 2048: turno de 14K tokens 2016 -> 3854 tok/s (7,5 s -> 3,9 s); ncmoe 16 -> 17 para manter
# ~960 MiB de VRAM livre (com 16 sobravam ~640). -t 6 (núcleos físicos) > -t 12. TUNING.md §19.
ExecStart=/home/lucas/git/llama.cpp/build/bin/llama-server -m /home/lucas/.lmstudio/models/lmstudio-community/Qwen3-Coder-30B-A3B-Instruct-GGUF/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf --host 0.0.0.0 --port 1234 -c 98304 -ngl 99 -fa 1 -ctk q4_0 -ctv q4_0 -t 6 --n-cpu-moe 17 -ub 2048 -b 2048 --jinja
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
