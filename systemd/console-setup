# CONFIGURATION FILE FOR SETUPCON
#
# Destino: /etc/default/console-setup
# Aplicado por: scripts/setup-system.sh (ou manual: sudo setupcon --save --force)
# Documentação: docs/console-setup.md
#
# Consult the console-setup(5) manual page.

ACTIVE_CONSOLES="/dev/tty[1-6]"

CHARMAP="UTF-8"

CODESET="Lat15"
FONTFACE="TerminusBold"
FONTSIZE="16x32"

VIDEOMODE=

