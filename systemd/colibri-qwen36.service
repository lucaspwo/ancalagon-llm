[Unit]
Description=Colibri server - Qwen3.6-35B-A3B MoE (CUDA VRAM tier, cap=256 full residency)
Conflicts=llama-coder.service llama-qwen36.service llama-qwen38.service llama-gemma4.service lmstudio.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lucas/git/colibri
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=COLI_CUDA=1
Environment=COLI_GPUS=0
Environment=CUDA_EXPERT_GB=auto
Environment=OMP_NUM_THREADS=6
Environment=OMP_WAIT_POLICY=PASSIVE
Environment=OMP_PROC_BIND=close
# Colibri recusa bindar 0.0.0.0 sem API key (guard de seguranca upstream). A rede confiavel aqui
# e o Tailscale/LAN, nao a API — mesmo modelo de ameaca dos llama-*.service, que tambem nao
# autenticam. Decisao explicita do Lucas (2026-09-27), nao default silencioso.
Environment=COLI_ALLOW_INSECURE_BIND=1
# Host guard (anti DNS-rebinding) do Colibri: sem isto so aceita Host=localhost e responde 403 a
# qualquer cliente remoto (opencode do Mac, gateway). Lista explicita em vez de '*' para manter o
# guard contra pagina maliciosa no navegador. Acrescente aqui o nome/IP que o cliente usar na URL.
Environment=COLI_ALLOWED_HOSTS=ancalagon-ubuntu,192.168.1.8
ExecStart=/home/lucas/git/colibri/.venv/bin/python3 /home/lucas/git/colibri/c/coli serve --model /mnt/black/colibri/qwen36_i4_gs64 --host 0.0.0.0 --port 1234 --auto-tier --cap 256 --gpu 0
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
